# _headers - النسخة المعمارية المصححة للروائع ERP

# 1. منع تكييش الـ Service Worker في المجلد الرئيسي
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# 2. منع تكييش الـ Service Worker في أي مجلد فرعي مهما كان عمقه
/**/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# 3. منع تكييش أي ملف HTML في المجلد الرئيسي
/*.html
  Cache-Control: no-cache, no-store, must-revalidate

# 4. منع تكييش أي ملف HTML في أي مجلد فرعي (مثل مجلدات الشركات أو الـ تلي سيلز)
/**/*.html
  Cache-Control: no-cache, no-store, must-revalidate
